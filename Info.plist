<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.github.choiyaki.couchNotes</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>couchnotes</string>
			</array>
		</dict>
	</array>
	<!-- 独自の暗号化はない（通信は OS の HTTPS）。TestFlight へ送るときの申告 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- couchimg の公開・削除は Tailscale の中の管理用の口（http://couchimg:8751）へ送る。
		     Tailscale が暗号化するので平文の HTTP。`.` のない名前などのローカル通信だけを許可する -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>手書きメモを写真アプリに保存するために使用します。</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.github.choiyaki.couchNotes.handwrite</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>手書きメモ</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>pencil.tip.crop.circle</string>
		</dict>
	</array>
</dict>
</plist>
